{
  "id": "lider",
  "title": "LIDER",
  "path": "/dashboard-lider",
  "parent_route": "/dashboard-infrastructure/overview",
  "icon": "mdi:transmission-tower",
  "owner": "lider_voltage_control",
  "preferred_view": "overview",
  "ui_version": "0.4.5",
  "template_version": "1.0",
  "module_url": "lider-voltage-control-panel.js",
  "frontend_delivery": {
    "mode": "single_stable_module",
    "runtime_previous_version_imports": false,
    "hero_composition": "separate_room_and_equipment_layers"
  },
  "rendering": {
    "stable_shell_dom": true,
    "shadow_root_inner_html": "initial_mount_only",
    "telemetry_updates": "patch_existing_nodes",
    "status_updates": "category_change_only",
    "preserve_on_update": ["header", "image", "zoom_viewport", "scroll", "bottom_tab_bar"],
    "structural_render_during_scroll": false
  },
  "shell": {
    "header_left_action": "hass-toggle-menu",
    "header_grid_px": [52, 0, 52],
    "header_button_px": 44,
    "header_icon_px": 25,
    "header_refresh_on_card": true,
    "header_refresh_tone": "primary",
    "bottom_tabs": ["overview", "before", "after", "line", "history"],
    "bottom_tab_min_height_px": 58,
    "bottom_icon_px": 28,
    "bottom_label_px": 12,
    "bottom_label_weight": 700,
    "bottom_full_width": true,
    "safe_area_once": true
  },
  "typography": {
    "meaningful_min_px": 12,
    "meaningful_max_px": 25,
    "status_main_px": 16,
    "status_secondary_px": 13
  },
  "zoom": {
    "viewport_count": 1,
    "min_percent": 75,
    "max_percent": 200,
    "default_percent": 100,
    "controls": "gesture_only",
    "reset": "two_finger_double_tap",
    "snap_percent": [97, 103],
    "persistent": true,
    "native_vertical_scroll_at_100_percent": true,
    "pan_only_when_scaled_content_overflows": true,
    "bounded_to_content_edges": true,
    "suppress_clicks_after_gesture": true
  },
  "history": {
    "provider": "home_assistant_history_graph",
    "periods": ["24h", "7d", "30d", "12m"],
    "metrics": ["voltage", "current", "power"],
    "scope": ["before_stabilizers", "after_stabilizers", "non_interruptible_line"],
    "excluded_metrics": ["generation", "produced_energy", "export_energy", "reverse_energy"]
  },
  "connection_status": {
    "enabled_by_repository_request": true,
    "visual_reference": "LIDER",
    "entity": "binary_sensor.power_meter_online",
    "states": ["local", "offline", "unknown"],
    "telemetry_states": ["current", "stale", "unknown"],
    "stale_after_poll_periods": 3,
    "default_poll_period_seconds": 30,
    "preserve_last_successful_snapshot": true
  }
}
