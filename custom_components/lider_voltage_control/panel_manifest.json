{
  "id": "lider",
  "title": "Электросеть",
  "path": "/dashboard-lider",
  "parent_route": "/dashboard-infrastructure/overview",
  "icon": "mdi:transmission-tower",
  "owner": "lider_voltage_control",
  "preferred_view": "overview",
  "ui_version": "0.9.1",
  "template_version": "1.9",
  "module_url": "lider-voltage-control-panel.js",
  "frontend_delivery": {
    "mode": "self_contained_bundle",
    "clean_rewrite": true,
    "source_module": "lider-voltage-control-panel-core.js",
    "build_script": "scripts/build-frontend-bundle.mjs",
    "production_equals_validated_source": true,
    "runtime_previous_version_imports": false,
    "hero_composition": "separate_room_and_equipment_layers"
  },
  "architecture": {
    "shell": "LiderVoltageControlPanel",
    "data_adapter": "DataAdapter",
    "history_store": "HistoryStore",
    "view_store": "ViewStore",
    "state_to_dom_policy": "targeted_patch_only",
    "view_lifecycle": "lazy_create_cache_reattach",
    "structural_keys": "never_telemetry_age"
  },
  "rendering": {
    "stable_shell_dom": true,
    "shadow_root_inner_html": "initial_mount_only",
    "telemetry_updates": "patch_existing_nodes",
    "diagnostics_updates": "keyed_entity_cards",
    "status_updates": "targeted_patch_only",
    "initial_state": "fixed_shell_then_first_view",
    "unknown_unavailable": "explicit_no_data",
    "hass_updates": "coalesced_to_one_animation_frame",
    "visited_views": "lazy_dom_cache_and_reattach_same_subtree",
    "preserve_on_update": ["header", "header_return_route", "image", "zoom_viewport", "scroll", "bottom_tab_bar"],
    "structural_render_during_scroll": false
  },
  "shell": {
    "header_left_action": "hass-toggle-menu",
    "header_center_action": "return_to_source_base_panel",
    "header_center_lines": ["title", "ui_version"],
    "header_history_back_allowed": false,
    "header_return_route_capture": ["first_valid_return_to_then_from", "paired_session_route_handoff", "saved_panel_route", "same_origin_referrer", "parent_route"],
    "header_return_route_capture_once": true,
    "header_handoff_timestamp_required": true,
    "header_handoff_max_age_ms": 30000,
    "header_handoff_consumed_once": true,
    "header_focus_visible": true,
    "header_pressed_response": true,
    "header_safe_default_route": "/dashboard-infrastructure/overview",
    "header_allowed_base_routes": ["/dashboard-house-v11/home", "/dashboard-actions/home", "/dashboard-infrastructure/overview"],
    "header_grid_px": [52, 0, 52],
    "header_button_px": 44,
    "header_icon_px": 25,
    "header_refresh_on_card": true,
    "header_refresh_tone": "primary",
    "bottom_tabs": ["overview", "before", "after", "history", "diagnostics"],
    "bottom_tabs_single_row": true,
    "bottom_tab_columns": 5,
    "bottom_tab_min_height_px": 52,
    "bottom_icon_px": 28,
    "bottom_label_px": 12,
    "bottom_label_mobile_px": 12,
    "bottom_full_width": true,
    "safe_area_once": true,
    "phone_shell": "fixed_host_three_row_grid",
    "outer_document_scroll": false,
    "work_viewport_scroll_chaining": false
  },
  "overview": {
    "equipment_model": "LIDER PS-7500W-30",
    "module_count": 3,
    "fills_work_viewport": true,
    "mobile_input_metrics": "compact_phase_strip_plus_operational_rows",
    "phase_cards_aligned_by_center": true,
    "connection_plaque": "canonical_s8_omni_geometry_top_right",
    "phase_cards_show_before_after_voltage_and_power": true,
    "localized_units": {"V": "В", "A": "А", "W": "Вт", "Hz": "Гц", "kWh": "kWh"},
    "diagnostics_visible_label": "Диагн.",
    "diagnostics_accessible_label": "Диагностика"
  },
  "zoom": {
    "viewport_count": 1,
    "min_percent": 75,
    "max_percent": 200,
    "default_percent": 100,
    "controls": "gesture_only",
    "reset": "two_finger_double_tap",
    "snap_percent": [97, 103],
    "persistent": true,
    "storage_scope": "panel_per_client",
    "native_vertical_scroll_at_100_percent": true,
    "one_finger_pan": "only_above_100_percent",
    "pan_only_when_scaled_content_overflows": true,
    "bounded_to_content_edges": true,
    "post_gesture_click_suppression": true,
    "wait_for_all_touches_to_end": true
  },
  "history": {
    "provider": "home_assistant_history",
    "primary_transport": "websocket_history_during_period",
    "fallback_transport": "recorder_rest",
    "rendering": "autonomous_svg",
    "lovelace_helpers_required": false,
    "single_flight_per_period": true,
    "cache_in_flight_and_completed_periods": true,
    "request_partition": "per_graph",
    "request_concurrency": 2,
    "request_timeout_seconds": 60,
    "significant_changes_only": true,
    "minimal_response": true,
    "no_attributes": true,
    "periods": ["24h", "7d", "30d", "12m"],
    "metrics": ["voltage", "current", "power"],
    "scope": ["before_stabilizers", "after_stabilizers", "non_interruptible_line"],
    "excluded_metrics": ["generation", "produced_energy", "export_energy", "reverse_energy"],
    "terminal_states": ["ready", "no_records", "missing_entity", "recorder_unavailable"]
  },
  "diagnostics": {
    "view": "diagnostics",
    "scope": ["input_meter", "after_lider_phase_a", "after_lider_phase_b", "after_lider_phase_c", "non_interruptible_line_ups"],
    "show_entity_state": true,
    "show_all_attributes": true,
    "show_state_timestamps": true,
    "show_context": true,
    "filter_generation_entities": false,
    "update_policy": "keyed_entity_cards",
    "entity_click": "hass-more-info"
  },
  "runtime_contract": {
    "fixed_entities": "previously_verified_only",
    "related_entities": "entity_registry_or_live_state_only",
    "synthetic_entity_ids": false,
    "missing_related_metrics": "explicit_no_data"
  },
  "connection_status": {
    "entity": "binary_sensor.power_meter_online",
    "states": ["local", "offline", "unknown"],
    "telemetry_states": ["current", "stale", "unknown"],
    "stale_after_poll_periods": 3,
    "default_poll_period_seconds": 30,
    "freshness_patch_period_seconds": 15,
    "preserve_last_successful_snapshot": false
  }
}
